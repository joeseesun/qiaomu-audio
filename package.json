{
  "name": "qiaomu-audio",
  "version": "1.1.0",
  "description": "在任意 Obsidian 笔记里一键朗读，按一下说话自动转成文字。",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "lint": "eslint src tests scripts",
    "check:i18n": "node scripts/check-i18n.mjs",
    "test": "node --test tests/*.test.mjs && python3 -I -m unittest discover -s tests -p 'test_*.py'",
    "check": "npm run check:i18n && npm run lint && npm test && npm run build"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "tts",
    "read-aloud",
    "dictation",
    "speech-to-text"
  ],
  "author": "向阳乔木",
  "license": "GPL-3.0-only",
  "devDependencies": {
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.1",
    "esbuild": "0.28.1",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "jsdom": "^29.1.1",
    "obsidian": "latest"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "mp4-muxer": "^5.2.2",
    "ws": "^8.22.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  },
  "exports": {
    "./speech": {
      "types": "./src/shared.d.ts",
      "default": "./src/shared.js"
    },
    "./speech/text": {
      "types": "./src/shared.d.ts",
      "default": "./src/core/tts/text.js"
    },
    "./speech/progress": {
      "types": "./src/shared.d.ts",
      "default": "./src/shared/progress.js"
    }
  },
  "overrides": {
    "moment": "2.31.0"
  }
}
